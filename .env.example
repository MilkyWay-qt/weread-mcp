# 复制为 .env 后按需修改（启动时会自动加载）

# ---- 必填：微信读书 API Key ----
# 前往 https://weread.qq.com/r/weread-skills 获取，格式 wrk-xxxxxxxx
# 如果留空，则要求 MCP 客户端在请求头携带 Authorization: Bearer wrk-xxxxxxxx
WEREAD_API_KEY=

# ---- MCP 传输 ----
# sse（默认，URL 连接） / streamable-http / stdio
WEREAD_MCP_TRANSPORT=sse
WEREAD_MCP_HOST=127.0.0.1
WEREAD_MCP_PORT=8000
WEREAD_MCP_SSE_PATH=/sse
WEREAD_MCP_MESSAGE_PATH=/messages/
WEREAD_MCP_HTTP_PATH=/mcp
WEREAD_MCP_LOG_LEVEL=INFO

# streamable-http 专用
WEREAD_MCP_JSON_RESPONSE=false
WEREAD_MCP_STATELESS=false

# ---- 网关 ----
WEREAD_API_BASE_URL=https://i.weread.qq.com/api/agent/gateway
WEREAD_SKILL_VERSION=1.0.4
WEREAD_REQUEST_TIMEOUT=30
# 是否允许客户端用请求头覆盖服务端 API Key（多用户部署时保持 true）
WEREAD_ALLOW_CLIENT_API_KEY=true

# ---- 公网部署（HTTPS 反向代理 / 隧道 / 云平台）----
# MCP 访问令牌，与微信读书 API Key 无关；公网部署必设，至少 16 位（推荐 openssl rand -hex 32）
# 客户端需携带 Authorization: Bearer <令牌> 或 X-API-Key: <令牌>
WEREAD_MCP_AUTH_TOKEN=
# 反向代理 / 隧道对外的域名，逗号分隔（服务监听 127.0.0.1 时必填）
WEREAD_MCP_ALLOWED_HOSTS=
